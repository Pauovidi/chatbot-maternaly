# Maternaly
APP_NAME=Maternaly
APP_ENV=development
APP_BASE_URL=http://localhost:3000
WHATSAPP_PROVIDER=mock
GOOGLE_SHEETS_ACCESS_MODE=dry_run
BOT_SHEETS_LIVE_WRITE_ENABLED=false
MATERNALY_SHEET_IDS=163BD-mjKeYGx7bjjUzW_FUYhwMUniLfHlhPnByZWOfI,1p74UI3SUFgtHCc5mSdW0RnmV2pnGECBTBudJz8YF5Do
LLM_PROVIDER=mock
LLM_MODEL=
PANEL_ADMIN_USERNAME=admin

# Secret values, intentionally empty here.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
OPENAI_API_KEY=
PANEL_ADMIN_PASSWORD=

# Legacy panel/admin env kept for the imported technical base.
# Panel admin
HOTEL_PANEL_USERNAME=
HOTEL_PANEL_PASSWORD=
HOTEL_PANEL_ALLOW_LOCAL_AUTH_BYPASS=

# App y persistencia
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1
# EasyPanel production must use postgres with DATABASE_URL.
# Leave blank in development to use the unsafe local JSON fallback.
HOTEL_PERSISTENCE_PROVIDER=
DATABASE_URL=
HOTEL_FILE_STORE_DIR=
HOTEL_CONVERSATIONS_STORE_PATH=
HOTEL_CONVERSATIONS_STORE_DIR=
HOTEL_CONVERSATIONS_DEMO_SEED=
HOTEL_DEMO_STORE_PATH=
HOTEL_DOMAIN_STORE_PATH=
HOTEL_REMINDERS_STORE_PATH=
HOTEL_EMAIL_STATE_STORE_PATH=

# Twilio WhatsApp Sandbox/real
HOTEL_CONVERSATIONS_MOCK_TWILIO=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_PROVIDER_MODE=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=
TWILIO_STATUS_CALLBACK_URL=

# Google Sheets real
HOTEL_USE_GOOGLE_SHEETS_REAL=
HOTEL_GOOGLE_SHEETS_SPREADSHEET_ID=
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
HOTEL_CLIENTS_SHEET_NAME=CLIENTES
HOTEL_CLIENTS_CACHE_TTL_MS=300000
HOTEL_GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
HOTEL_GOOGLE_SHEETS_PRIVATE_KEY=

# Email IMAP real
HOTEL_USE_MOCK_EMAIL_INPUT=true
HOTEL_EMAIL_IMAP_HOST=
HOTEL_EMAIL_IMAP_PORT=993
HOTEL_EMAIL_IMAP_SECURE=true
HOTEL_EMAIL_IMAP_USER=
HOTEL_EMAIL_IMAP_PASSWORD=
HOTEL_EMAIL_IMAP_MAILBOX=INBOX

# Recordatorios
HOTEL_USE_REMINDERS_REAL=false
HOTEL_REMINDER_WEBHOOK_URL=
HOTEL_REMINDER_LEAD_HOURS=120
